{
  "name": "salvoconquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimalist multiplayer archipelago naval RTS. Runs on a Cloudflare Worker.",
  "scripts": {
    "dev": "node scripts/voice-manifest.mjs && vite",
    "build": "node scripts/voice-manifest.mjs && vite build",
    "local": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=.wrangler/sim-test.mjs --log-level=warning && node .wrangler/sim-test.mjs",
    "bench:ai": "esbuild scripts/ai-bench.ts --bundle --platform=node --format=esm --external:esbuild --outfile=.wrangler/ai-bench.mjs --log-level=warning && node .wrangler/ai-bench.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.151.0"
  }
}
