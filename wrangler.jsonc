{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salvoconquest",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-09-01",
  // Static client (built by `npm run build`) is served from ./dist.
  // Only /api/* and /ws/* run the Worker code first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // One Durable Object instance = one game room (lobby + authoritative simulation).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
